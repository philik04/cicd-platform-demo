# Dependencies
node_modules/

# Build output
dist/
build/
coverage/
*.tsbuildinfo

# Environment files (never commit real secrets)
.env
.env.local
.env.*.local
!.env.example

# Logs
*.log
npm-debug.log*

# OS files
.DS_Store
Thumbs.db

# Editor
.vscode/*
!.vscode/extensions.json
.idea/

# Terraform (the .terraform.lock.hcl provider lock file IS committed)
infrastructure/terraform/.terraform/
infrastructure/terraform/*.tfstate
infrastructure/terraform/*.tfstate.*
infrastructure/terraform/*.tfvars
!infrastructure/terraform/*.tfvars.example
infrastructure/terraform/crash.log
infrastructure/terraform/override.tf
infrastructure/terraform/*.pem

# Prisma
backend/prisma/*.db

# Misc
*.pem
*.key
