# Root environment file consumed by docker-compose.yml.
# Copy to .env before running `docker compose up --build` (never commit .env).

# --- PostgreSQL ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=cicd_platform_demo
POSTGRES_PORT=5432

# --- Backend ---
BACKEND_PORT=4000
NODE_ENV=production
LOG_LEVEL=info
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
# Must match wherever the frontend is served from.
CORS_ORIGIN=http://localhost:8080

# --- Frontend ---
FRONTEND_PORT=8080
