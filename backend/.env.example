# Copy this file to .env for local development (never commit .env).

NODE_ENV=development
PORT=4000

# Local dev default matches the postgres service in docker-compose.yml.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cicd_platform_demo?schema=public

CORS_ORIGIN=http://localhost:5173

LOG_LEVEL=info

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
