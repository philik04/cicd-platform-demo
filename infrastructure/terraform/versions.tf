terraform {
  required_version = ">= 1.6.0"

  required_providers {
    aws = {
      source  = "hashicorp/aws"
      version = "~> 5.60"
    }
  }

  # For a portfolio/demo deployment, local state is acceptable. For team use,
  # replace this with a remote backend, e.g.:
  #
  # backend "s3" {
  #   bucket         = "your-terraform-state-bucket"
  #   key            = "cicd-platform-demo/terraform.tfstate"
  #   region         = "us-east-1"
  #   dynamodb_table = "terraform-locks"
  #   encrypt        = true
  # }
}

provider "aws" {
  region = var.aws_region

  default_tags {
    tags = {
      Project     = var.project_name
      Environment = var.environment
      ManagedBy   = "terraform"
    }
  }
}
